@{
Page.Title = "About Us";
}

<style>
    /* =========================
       ABOUT PAGE
       ========================= */

    #main {
        margin: 0;
        padding: 0;
    }

    .about-page {
        font-family: Arial, Helvetica, sans-serif;
        color: #3d2b1f;
        background: #fffaf5;
    }

    /* HERO */
    .about-hero {
        position: relative;
        overflow: hidden;
        padding: 90px 30px;
        text-align: center;
        background: linear-gradient(135deg, #3d2115, #7b3f20, #b66a35);
        color: white;
    }

    .about-hero:before,
    .about-hero:after {
        content: "";
        position: absolute;
        border-radius: 50%;
        background: rgba(255,255,255,0.08);
    }

    .about-hero:before {
        width: 300px;
        height: 300px;
        top: -120px;
        left: -80px;
    }

    .about-hero:after {
        width: 400px;
        height: 400px;
        bottom: -200px;
        right: -100px;
    }

    .hero-content {
        position: relative;
        z-index: 2;
        max-width: 850px;
        margin: auto;
    }

    .coffee-icon {
        font-size: 55px;
        margin-bottom: 15px;
    }

    .about-hero h1 {
        font-size: 52px;
        margin: 0 0 15px;
        font-weight: 800;
        letter-spacing: -1px;
    }

    .about-hero p {
        max-width: 700px;
        margin: auto;
        font-size: 19px;
        line-height: 1.7;
        color: #f9e9dc;
    }

    /* STORY */
    .about-container {
        max-width: 1100px;
        margin: auto;
        padding: 70px 25px;
    }

    .story-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 50px;
        align-items: center;
    }

    .story-content h2 {
        font-size: 36px;
        margin: 0 0 20px;
        color: #4b2818;
    }

    .story-content h2 span {
        color: #a85d2b;
    }

    .story-content p {
        font-size: 17px;
        line-height: 1.8;
        color: #68574d;
        margin-bottom: 18px;
    }

    .story-card {
        background: white;
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 15px 45px rgba(70, 40, 20, 0.12);
        text-align: center;
        border: 1px solid #f0dfd2;
    }

    .story-card .big-icon {
        font-size: 75px;
        margin-bottom: 15px;
    }

    .story-card h3 {
        font-size: 25px;
        color: #4b2818;
        margin-bottom: 10px;
    }

    .story-card p {
        color: #79675d;
        line-height: 1.6;
    }

    /* STATS */
    .stats-section {
        background: #f1e4d8;
        padding: 55px 25px;
    }

    .stats {
        max-width: 1000px;
        margin: auto;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 25px;
        text-align: center;
    }

    .stat {
        padding: 20px;
    }

    .stat-number {
        font-size: 42px;
        font-weight: 800;
        color: #8c4c25;
        margin-bottom: 8px;
    }

    .stat-label {
        font-size: 16px;
        color: #5f4d42;
        font-weight: 600;
    }

    /* VALUES */
    .values-section {
        max-width: 1100px;
        margin: auto;
        padding: 75px 25px;
        text-align: center;
    }

    .values-section h2 {
        font-size: 36px;
        color: #4b2818;
        margin-bottom: 12px;
    }

    .section-subtitle {
        color: #79675d;
        font-size: 17px;
        margin-bottom: 45px;
    }

    .values-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 25px;
    }

    .value-card {
        background: white;
        border-radius: 18px;
        padding: 35px 25px;
        border: 1px solid #f0dfd2;
        box-shadow: 0 10px 30px rgba(70, 40, 20, 0.07);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .value-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 18px 40px rgba(70, 40, 20, 0.14);
    }

    .value-icon {
        font-size: 42px;
        margin-bottom: 15px;
    }

    .value-card h3 {
        color: #4b2818;
        font-size: 21px;
        margin-bottom: 12px;
    }

    .value-card p {
        color: #75645a;
        line-height: 1.6;
        font-size: 15px;
    }

    /* CTA */
    .about-cta {
        margin-top: 20px;
        padding: 70px 25px;
        text-align: center;
        background: linear-gradient(135deg, #4a2819, #8b4c28);
        color: white;
    }

    .about-cta h2 {
        font-size: 36px;
        margin: 0 0 15px;
    }

    .about-cta p {
        font-size: 17px;
        color: #f3dfd0;
        margin-bottom: 28px;
    }

    .cta-button {
        display: inline-block;
        padding: 14px 30px;
        border-radius: 30px;
        background: white;
        color: #713d20;
        text-decoration: none;
        font-weight: bold;
        transition: transform 0.2s ease;
    }

    .cta-button:hover {
        transform: scale(1.05);
    }

    /* MOBILE */
    @media (max-width: 768px) {

        .about-hero {
            padding: 65px 20px;
        }

        .about-hero h1 {
            font-size: 38px;
        }

        .about-hero p {
            font-size: 16px;
        }

        .story-grid {
            grid-template-columns: 1fr;
        }

        .stats {
            grid-template-columns: 1fr;
        }

        .values-grid {
            grid-template-columns: 1fr;
        }

        .story-content h2,
        .values-section h2,
        .about-cta h2 {
            font-size: 30px;
        }
    }
</style>

<div class="about-page">

